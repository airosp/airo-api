# ─────────────────────────────────────────────────────────────────────────────
# Modelo. Copia para `.env`. Valores reais NUNCA entram neste ficheiro.
# ─────────────────────────────────────────────────────────────────────────────
AIRO_ENV=development           # development | staging | production
AIRO_HTTP_ADDR=:8080
AIRO_DATABASE_URL=postgres://airo:airo@localhost:5432/airo?sslmode=disable
AIRO_REDIS_URL=redis://localhost:6379/0

# Pepper do HMAC dos códigos OTP. Vive FORA da base de dados, num gestor de
# segredos. Sem isto, uma fuga da BD entrega todos os códigos activos.
AIRO_OTP_PEPPER=

# Assinatura dos access tokens.
AIRO_JWT_SECRET=

# WhatsApp Cloud API
AIRO_WHATSAPP_PHONE_NUMBER_ID=
AIRO_WHATSAPP_TOKEN=
AIRO_WHATSAPP_TEMPLATE=airo_otp
AIRO_WHATSAPP_WEBHOOK_SECRET=
