# ─────────────────────────────────────────────────────────────────────────────
# Modelo. Copia para `.env`. Valores reais NUNCA entram neste ficheiro.
# ─────────────────────────────────────────────────────────────────────────────
AIRO_ENV=development           # development | staging | production
AIRO_HTTP_ADDR=:8080
AIRO_DATABASE_URL=postgres://airo:airo@localhost:5432/airo?sslmode=disable
AIRO_REDIS_URL=redis://localhost:6379/0

# Pepper do HMAC dos códigos OTP. Vive FORA da base de dados, num gestor de
# segredos. Sem isto, uma fuga da BD entrega todos os códigos activos.
AIRO_OTP_PEPPER=

# Assinatura dos access tokens.
AIRO_JWT_SECRET=

# WhatsApp Cloud API
AIRO_WHATSAPP_PHONE_NUMBER_ID=
AIRO_WHATSAPP_TOKEN=
AIRO_WHATSAPP_TEMPLATE=airo_otp
AIRO_WHATSAPP_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Mux — as aulas gravadas dos profissionais
# ─────────────────────────────────────────────────────────────────────────────
#
# São DUAS credenciais diferentes, e confundi-las dá erros que não se explicam:
#
#   TOKEN_ID/TOKEN_SECRET  abrem a API — criar recursos, saber o estado de um.
#                          Nunca chegam a um telemóvel.
#   SIGNING_KEY            só assina o acesso a um vídeo, por um prazo. É outra
#                          chave, de outro tipo, criada noutro sítio da consola.
#
# Sem chave de assinatura a reprodução é pública: qualquer pessoa com o
# endereço vê a aula, sem conta. Diz-se no arranque, em vez de acontecer em
# silêncio.
AIRO_MUX_TOKEN_ID=
AIRO_MUX_TOKEN_SECRET=
AIRO_MUX_SIGNING_KEY_ID=
# A chave privada em base64, como a consola do Mux a dá. O PEM em claro
# também serve.
AIRO_MUX_SIGNING_KEY=
# Assina as notificações. Vazio NÃO regista a rota `/v1/webhooks/mux`: um
# webhook aberto deixa qualquer pessoa apontar as nossas aulas aos vídeos dela.
AIRO_MUX_WEBHOOK_SECRET=
# Quanto tempo um endereço serve. Uma hora: uma aula longa vista com pausas
# não pode ficar sem endereço a meio.
AIRO_MUX_TTL_SECONDS=3600
# O segundo de onde sai a miniatura. Zero é quase sempre um fotograma preto.
AIRO_MUX_THUMBNAIL_TIME=3
# A origem do painel que envia os ficheiros, para o CORS do destino de upload.
AIRO_MUX_UPLOAD_ORIGIN=
